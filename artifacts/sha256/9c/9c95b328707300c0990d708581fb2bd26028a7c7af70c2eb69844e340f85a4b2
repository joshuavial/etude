+compare_bytes() {
+    local label="$1"
+    local expected="$2"
+    local actual="$3"
+    if cmp "$expected" "$actual"; then
+        return 0
+    fi
+
+    local expected_bytes="$(wc -c < "$expected" | tr -d ' ')"
+    local actual_bytes="$(wc -c < "$actual" | tr -d ' ')"
+    echo "byte mismatch ($label): expected_bytes=$expected_bytes actual_bytes=$actual_bytes" >&2
+    return 1
+}
