-            sub(/^path=/, "", $i)
-            print $i
-            exit
-        }
-    }
-')"
+    OUTPUT_COUNT=$((OUTPUT_COUNT + 1))
+    if [ "$stage" = "tone-police" ] && [ -z "$TONED_PATH" ]; then
+        TONED_PATH="$artifact_path"
+    fi
+done < "$OUTPUT_ARTIFACTS"
+[ "$OUTPUT_COUNT" -eq 5 ] || { echo "expected 5 stage outputs in manifest, found $OUTPUT_COUNT" >&2; exit 1; }
