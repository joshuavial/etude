+				report.Variant,
+				report.WinRate*100,
+				report.CatchRate*100,
+				report.AvoidOverblockRate*100,
+				report.Total,
+				report.Scored,
+				explicit,
+				proxy,
+				report.Unlabeled,
+				report.Matrix.TruePositive,
+				report.Matrix.FalseNegative,
+				report.Matrix.FalsePositive,
