+func (g doctorGit) lsRemote(ctx context.Context, remoteURL string, env []string) ([]byte, error) {
+	cmd := exec.CommandContext(ctx, "git", "ls-remote", "--end-of-options", remoteURL, "refs/etude/*")
+	cmd.Dir = doctorNeutralDir(g.root)
+	cmd.Env = env
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return nil, err
+	}
+	var stderr doctorLimitedBuffer
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		return nil, err
+	}
+	out, readErr := io.ReadAll(io.LimitReader(stdout, doctorRemoteOutputLimit+1))
+	if len(out) > doctorRemoteOutputLimit {
+		_ = stdout.Close()
+		if cmd.Process != nil {
+			_ = cmd.Process.Kill()
+		}
+		_ = cmd.Wait()
+		return nil, fmt.Errorf("remote advertisement exceeds %d bytes", doctorRemoteOutputLimit)
+	}
+	waitErr := cmd.Wait()
+	if readErr != nil {
+		return nil, readErr
+	}
+	if waitErr != nil {
+		message := strings.TrimSpace(stderr.String())
+		message = strings.ReplaceAll(message, remoteURL, "[remote URL redacted]")
+		if message == "" {
+			return nil, waitErr
+		}
+		return nil, fmt.Errorf("%w: %s", waitErr, message)
+	}
+	return out, nil
+}
+
+func (g doctorGit) readOnlyCredential(ctx context.Context, remoteURL string) (string, string, error) {
+	cmd := exec.CommandContext(ctx, "git", "credential", "fill")
+	cmd.Dir = doctorNeutralDir(g.root)
+	cmd.Env = doctorCredentialLookupEnv()
+	cmd.Stdin = strings.NewReader("url=" + remoteURL + "\n\n")
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return "", "", err
+	}
+	var stderr doctorLimitedBuffer
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		return "", "", err
+	}
+	out, readErr := io.ReadAll(io.LimitReader(stdout, (64<<10)+1))
+	if len(out) > 64<<10 {
+		_ = stdout.Close()
+		if cmd.Process != nil {
+			_ = cmd.Process.Kill()
+		}
+		_ = cmd.Wait()
+		return "", "", fmt.Errorf("credential helper output exceeds 65536 bytes")
+	}
+	waitErr := cmd.Wait()
+	if readErr != nil {
+		return "", "", readErr
+	}
+	if waitErr != nil {
+		return "", "", waitErr
+	}
+	values := make(map[string]string)
+	for _, line := range strings.Split(string(out), "\n") {
+		key, value, ok := strings.Cut(line, "=")
+		if ok {
+			values[key] = value
+		}
+	}
+	if values["username"] == "" || values["password"] == "" {
+		return "", "", fmt.Errorf("credential helper returned no username/password")
+	}
+	return values["username"], values["password"], nil
+}
