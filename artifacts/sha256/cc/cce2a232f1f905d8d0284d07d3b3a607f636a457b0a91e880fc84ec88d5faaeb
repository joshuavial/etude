+var (
+	doctorCustomRemoteHelper = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9+.-]*::`)
+	doctorURLScheme          = regexp.MustCompile(`^([A-Za-z][A-Za-z0-9+.-]*)://`)
+	doctorSCPRemote          = regexp.MustCompile(`^[^/]+:[^/].*`)
+)
+
+type doctorLimitedBuffer struct {
+	buf bytes.Buffer
+}
+
+func (b *doctorLimitedBuffer) Write(p []byte) (int, error) {
+	original := len(p)
+	remaining := doctorRemoteOutputLimit - b.buf.Len()
+	if remaining > 0 {
+		if len(p) > remaining {
+			p = p[:remaining]
+		}
+		_, _ = b.buf.Write(p)
+	}
+	return original, nil
+}
+
+func (b *doctorLimitedBuffer) String() string { return b.buf.String() }
