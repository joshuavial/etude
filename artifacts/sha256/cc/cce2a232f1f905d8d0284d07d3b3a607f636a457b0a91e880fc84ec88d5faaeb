+func (g doctorGit) remoteEtudeRefs(ctx context.Context, remoteURL string) (map[string]string, error) {
+	if err := doctorValidateRemoteURL(remoteURL); err != nil {
+		return nil, err
+	}
+	remoteCtx, cancel := context.WithTimeout(ctx, doctorRemoteTimeout)
+	defer cancel()
+	out, firstErr := g.lsRemote(remoteCtx, remoteURL, doctorNeutralRemoteEnv())
+	if firstErr != nil && doctorHTTPRemote(remoteURL) {
+		username, password, credentialErr := g.readOnlyCredential(remoteCtx, remoteURL)
+		if credentialErr == nil {
+			out, firstErr = g.lsRemote(remoteCtx, remoteURL, doctorAuthenticatedRemoteEnv(username, password))
+		}
+	}
+	if remoteCtx.Err() != nil {
+		return nil, fmt.Errorf("timed out after %s", doctorRemoteTimeout)
+	}
+	if firstErr != nil {
+		return nil, firstErr
+	}
+	refs := make(map[string]string)
+	for _, line := range strings.Split(strings.TrimSpace(string(out)), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 {
+			refs[fields[1]] = fields[0]
+		}
+	}
+	return refs, nil
+}
