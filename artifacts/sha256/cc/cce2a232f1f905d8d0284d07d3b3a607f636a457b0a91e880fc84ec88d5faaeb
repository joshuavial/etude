+func doctorValidateRemoteURL(remoteURL string) error {
+	if strings.ContainsAny(remoteURL, "\x00\r\n") {
+		return fmt.Errorf("remote URL contains a control character")
+	}
+	if doctorCustomRemoteHelper.MatchString(remoteURL) {
+		return fmt.Errorf("custom remote-helper transport is not executed by read-only doctor")
+	}
+	match := doctorURLScheme.FindStringSubmatch(remoteURL)
+	if len(match) == 0 {
+		return nil
+	}
+	switch strings.ToLower(match[1]) {
+	case "file", "git", "http", "https", "ssh", "ftp", "ftps":
+		return nil
+	default:
+		return fmt.Errorf("unknown URL transport %q is not executed by read-only doctor", match[1])
+	}
+}
+
+func doctorEqualStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
