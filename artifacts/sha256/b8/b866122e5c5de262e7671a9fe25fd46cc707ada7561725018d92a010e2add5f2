+
+func sessionSeenBefore(stages []runmanifest.Stage, sessionID string) bool {
+	for _, stage := range stages {
+		if session := stage.Producer.Session; session != nil && session.SessionID == sessionID {
+			return true
+		}
+	}
+	return false
+}
