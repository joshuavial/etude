+func stageByName(stages []runmanifest.Stage, name string) (runmanifest.Stage, int, bool) {
+	for i := len(stages) - 1; i >= 0; i-- {
+		if stages[i].Name == name {
+			return stages[i], i, true
+		}
+	}
+	return runmanifest.Stage{}, 0, false
