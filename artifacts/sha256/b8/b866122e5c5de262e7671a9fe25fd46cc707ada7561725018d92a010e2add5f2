+		if err != nil {
+			return nil, nil, err
+		}
+		if stage.Log != nil {
+			attempt.LogDigest = stage.Log.Artifact
+			attempt.LogRole = fmt.Sprintf("prior-attempt-%d-log", attemptNumber)
+			refs, inputs, err = appendPriorAttemptArtifact(refs, inputs, files, *stage.Log, attempt.LogRole)
+			if err != nil {
