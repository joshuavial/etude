+	for i := 1; i <= 4; i++ {
+		ref := refs[i]
+		if ref.Artifact != output.Artifact || ref.Role != fmt.Sprintf("prior-attempt-%d-output", i) {
+			t.Fatalf("output ref[%d] = %#v", i, ref)
+		}
+	}
