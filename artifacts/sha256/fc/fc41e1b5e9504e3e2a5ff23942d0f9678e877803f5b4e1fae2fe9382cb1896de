+func filterPriorAttemptInputs(refs []runmanifest.ArtifactRef, inputs []replay.RunInput) ([]runmanifest.ArtifactRef, []replay.RunInput) {
+	filteredRefs := make([]runmanifest.ArtifactRef, 0, len(refs))
