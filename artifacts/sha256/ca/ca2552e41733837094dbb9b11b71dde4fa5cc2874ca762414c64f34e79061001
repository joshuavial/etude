+	bare := setupBareRemote(t, repoA)
+
+	capture1Stage(t, repoA, "shared", "plan", "plan.md", "# plan")
+	chdir(t, repoA)
+	if _, stderr, err := execute("sync"); err != nil {
+		t.Fatalf("seed sync: %v\nstderr: %s", err, stderr)
+	}
