	divergeEvalRef(t, repoB, "eval-1", baseOID, "eval_b.txt", "B diverged")

	// B syncs → push must be rejected with the full eval ref path.
	chdir(t, repoB)
	_, stderr, err := execute("sync")
	if err == nil {
