	}
	if err := os.WriteFile(hookPath, []byte("#!/bin/sh\nexit 1\n"), 0o755); err != nil {
		t.Fatalf("write pre-receive hook: %v", err)
	}

	capture1Stage(t, repoA, "run-1", "plan", "plan.md", "# plan")
	chdir(t, repoA)
