	if e.MaxOutputBytes > 0 && fi.Size() > e.MaxOutputBytes {
		return JudgeResponse{}, fmt.Errorf("%w: file size %d exceeds cap %d: %s", ErrJudgeOutputTooLarge, fi.Size(), e.MaxOutputBytes, outputPath)
	}

