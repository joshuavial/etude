	// Materialise rubric bytes when present.
	rubricPath := filepath.Join(scratch, "rubric")
	if req.Rubric != nil {
		if err := os.WriteFile(rubricPath, req.Rubric, 0o644); err != nil {
			return JudgeResponse{}, fmt.Errorf("%w: write rubric: %v", ErrJudgeFailed, err)
		}
	}

