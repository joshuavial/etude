+	cmd := exec.CommandContext(ctx, "git", "-C", cwd, "rev-parse", "--show-toplevel")
+	cmd.Env = doctorGitEnv()
+	out, err := cmd.Output()
+	if err != nil {
+		return "", fmt.Errorf("not a git repository (or any parent up to root %s)", cwd)
+	}
+	return strings.TrimSpace(string(out)), nil
