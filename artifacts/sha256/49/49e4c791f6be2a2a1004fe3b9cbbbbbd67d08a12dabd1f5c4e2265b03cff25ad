+func (g doctorGit) remoteEtudeRefs(ctx context.Context, remoteURL string) (map[string]string, error) {
+	if err := doctorValidateRemoteURL(remoteURL); err != nil {
+		return nil, err
+	}
+	remoteCtx, cancel := context.WithTimeout(ctx, doctorRemoteTimeout)
+	defer cancel()
+	cmd := exec.CommandContext(remoteCtx, "git", "ls-remote", "--end-of-options", remoteURL, "refs/etude/*")
+	cmd.Dir = doctorNeutralDir(g.root)
+	cmd.Env = doctorNeutralRemoteEnv()
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return nil, err
+	}
+	var stderr doctorLimitedBuffer
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		return nil, err
+	}
+	out, readErr := io.ReadAll(io.LimitReader(stdout, doctorRemoteOutputLimit+1))
+	if len(out) > doctorRemoteOutputLimit {
+		cancel()
+		_ = cmd.Wait()
+		return nil, fmt.Errorf("remote advertisement exceeds %d bytes", doctorRemoteOutputLimit)
+	}
+	waitErr := cmd.Wait()
+	if remoteCtx.Err() != nil {
+		return nil, fmt.Errorf("timed out after %s", doctorRemoteTimeout)
+	}
+	if readErr != nil {
+		return nil, readErr
+	}
+	if waitErr != nil {
+		message := strings.TrimSpace(stderr.String())
+		if message == "" {
+			return nil, waitErr
+		}
+		return nil, fmt.Errorf("%w: %s", waitErr, message)
+	}
+	refs := make(map[string]string)
+	for _, line := range strings.Split(strings.TrimSpace(string(out)), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 {
+			refs[fields[1]] = fields[0]
+		}
+	}
+	return refs, nil
+}
