+func (g doctorGit) remoteEtudeRefs(ctx context.Context, remoteURL string) (map[string]string, error) {
+	if doctorCustomRemoteHelper.MatchString(strings.TrimSpace(remoteURL)) {
+		return nil, fmt.Errorf("custom remote-helper transport is not executed by read-only doctor")
+	}
+	remoteCtx, cancel := context.WithTimeout(ctx, doctorRemoteTimeout)
+	defer cancel()
+	cmd := exec.CommandContext(remoteCtx, "git", "ls-remote", "--end-of-options", remoteURL, "refs/etude/*")
+	cmd.Dir = doctorNeutralDir(g.root)
+	cmd.Env = doctorNeutralRemoteEnv()
+	out, err := cmd.Output()
+	if remoteCtx.Err() != nil {
+		return nil, fmt.Errorf("timed out after %s", doctorRemoteTimeout)
+	}
+	if err != nil {
+		return nil, err
+	}
+	refs := make(map[string]string)
+	for _, line := range strings.Split(strings.TrimSpace(string(out)), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 {
+			refs[fields[1]] = fields[0]
+		}
+	}
+	return refs, nil
+}
