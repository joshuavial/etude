func TestQAPreflightBeforeCheckout(t *testing.T) {
	repo, runID := createRunForReplay(t)
	want := errors.New("qa resolution rejected last stage")
	err := ReplayForward(context.Background(), refstore.New(repo), filepath.Join(t.TempDir(), "not-a-repository"), &bytes.Buffer{}, runID,
		func(name string) (replay.Runner, error) {
			if name == "stage-c" { return nil, want }
			return runnerFunc(func(context.Context, replay.RunRequest) (replay.RunResult,error) { t.Fatal("runner invoked before complete preflight"); return replay.RunResult{}, nil }), nil
		})
	if !errors.Is(err, want) { t.Fatalf("wanted runner error before impossible checkout, got %v", err) }
}

func TestQARecordedRequestPreserved(t *testing.T) {
	repo, runID := createRunForReplay(t)
	rewriteLiveManifest(t, repo, runID, func(m *runmanifest.Manifest) {
		for i := range m.Stages {
			m.Stages[i].Producer.Model = fmt.Sprintf("original-model-%d",i)
			m.Stages[i].Producer.Harness = runmanifest.Harness{Name:"source-harness",Version:"original-version"}
		}
	})
	m := readLiveManifest(t, repo, runID)
	store := refstore.New(repo)
	commit, err := store.Resolve(context.Background(), runsPrefix+runID)
	if err != nil { t.Fatal(err) }
	resolved, executed := 0, 0
	err = ReplayForward(context.Background(), store, repo, &bytes.Buffer{}, runID, func(name string) (replay.Runner,error) {
		stage := m.Stages[resolved]
		if name != stage.Name { t.Fatalf("resolution order: got %s, want %s",name,stage.Name) }
		resolved++
		return runnerFunc(func(ctx context.Context, req replay.RunRequest) (replay.RunResult,error) {
			if m.Stages[executed].Name != stage.Name { t.Fatal("execution order changed") }
			executed++
			if !reflect.DeepEqual(req.Producer,stage.Producer) { t.Fatalf("producer changed: got %#v want %#v",req.Producer,stage.Producer) }
			if req.OutputRole != stage.Output.Role || req.OutputMediaType != stage.Output.MediaType { t.Fatal("output metadata changed") }
			if len(req.Inputs) != len(stage.Inputs) { t.Fatal("input count changed") }
			for i, input := range stage.Inputs {
				content, err := store.ReadCommitFile(ctx,commit,input.Path)
				if err != nil { t.Fatal(err) }
				if !bytes.Equal(content,req.Inputs[i].Content) || input.Role != req.Inputs[i].Role || input.MediaType != req.Inputs[i].MediaType { t.Fatal("recorded input changed") }
			}
			return replay.RunResult{Output:[]byte("new output must not become an input")},nil
		}),nil
	})
	if err != nil { t.Fatal(err) }
	if executed != len(m.Stages) { t.Fatalf("executed %d stages",executed) }
}

