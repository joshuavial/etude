    harness:  gemini-cli 3.1
    verdict:  go
  seat: opus
    provider: anthropic / claude-opus-4-7
    harness:  claude-code opus-4-7
    verdict:  go
  seat: codex
    provider: openai / gpt-5.5
    harness:  codex gpt-5.5-xhigh
    verdict:  go
    session_id: 019f...
    retrieval: imported
    redaction: passed
    transcript_artifact: artifacts/sha256/ab/abcdef...
  seat: pilms
